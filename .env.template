ANTHROPIC_API_KEY=your-api-key-here

# Supabase — auth + data storage. The anon key is safe to ship to the client (see lib/supabase.js);
# it only grants what supabase/schema.sql's RLS policies allow.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service-role key — bypasses RLS entirely. Supabase dashboard → Settings → API → service_role
# secret. Used ONLY by the scheduled SMS cron routes (app/api/cron/*, lib/sms/cronSend.js), which
# need to read every user's row to fan out the daily texts — no client code, and no other server
# route, ever references this. Never commit the real value; keep it out of any log or chat too.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# SMS reminders (Twilio) — server-only, never exposed to the client.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Preferred: your approved A2P 10DLC campaign's Messaging Service SID (MG...) — messages sent
# this way are tied to the campaign for carrier filtering. TWILIO_FROM_NUMBER is a fallback used
# only if this isn't set (a bare number with no registered campaign risks carrier filtering).
TWILIO_MESSAGING_SERVICE_SID=your-messaging-service-sid
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Scheduled SMS cron auth (app/api/cron/*) — Vercel automatically sends this exact value as
# `Authorization: Bearer <CRON_SECRET>` on every Cron Job invocation once it's set as an env var
# here AND in Vercel's project settings; the routes reject any request that doesn't match. Any
# random long string works — generate one with `openssl rand -hex 32`, it's never typed by a human.
CRON_SECRET=your-random-cron-secret
