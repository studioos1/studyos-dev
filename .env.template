ANTHROPIC_API_KEY=your-api-key-here

# Supabase — auth + data storage. The anon key is safe to ship to the client (see lib/supabase.js);
# it only grants what supabase/schema.sql's RLS policies allow. No service-role key belongs here —
# this app never uses one anywhere.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SMS reminders (Twilio) — server-only, never exposed to the client.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Preferred: your approved A2P 10DLC campaign's Messaging Service SID (MG...) — messages sent
# this way are tied to the campaign for carrier filtering. TWILIO_FROM_NUMBER is a fallback used
# only if this isn't set (a bare number with no registered campaign risks carrier filtering).
TWILIO_MESSAGING_SERVICE_SID=your-messaging-service-sid
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
