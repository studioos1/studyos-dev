ANTHROPIC_API_KEY=your-api-key-here

# Supabase — auth + data storage. The anon key is safe to ship to the client (see lib/supabase.js);
# it only grants what supabase/schema.sql's RLS policies allow. No service-role key belongs here —
# this app never uses one anywhere.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SMS reminders (Twilio) — server-only, never exposed to the client.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
